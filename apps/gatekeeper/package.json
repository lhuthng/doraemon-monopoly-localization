{
  "name": "doraemon-monopoly-gatekeeper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "bun build src/index.ts --outdir dist --format esm",
    "deploy": "bun run build && wrangler deploy",
    "mint-coupon": "bun scripts/mint-coupon.ts",
    "add-coupon": "bun scripts/add-coupon.ts",
