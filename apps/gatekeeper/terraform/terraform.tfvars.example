# Copy to terraform.tfvars and fill in real values. Never commit terraform.tfvars.
# The Cloudflare API token is read from the CLOUDFLARE_API_TOKEN environment
# variable and is never stored here.

account_id = "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID"
worker_name = "doraemon-gatekeeper"
bucket_name = "doraemon-files"
kv_namespace_title = "doraemon-gatekeeper-limits"
allowed_origins = ""
